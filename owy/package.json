{
  "name": "owy",
  "version": "0.1.0",
  "private": true,
  "description": "Owy — la mascota de OWU: asistente durable de OWU Conf y la comunidad (Eve agent)",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "eve dev",
    "build": "eve build",
    "start": "eve start",
    "eval": "eve eval",
    "typecheck": "tsc --noEmit",
    "companion:dev": "tsx watch companion/bridge/src/main.ts",
    "companion:start": "tsx companion/bridge/src/main.ts",
    "companion:serve": "sh companion/scripts/serve-mac.sh",
    "companion:text": "tsx companion/bridge/src/cli/text.ts",
    "companion:test": "vitest run --config companion/bridge/vitest.config.ts",
    "companion:tools": "tsx companion/bridge/src/cli/tools.ts",
    "companion:probe": "tsx companion/bridge/src/cli/probe.ts",
    "companion:netcheck": "tsx companion/bridge/src/cli/netcheck.ts",
    "companion:interaction-test": "node companion/firmware/tests/companion.mjs",
    "companion:pitch": "tsx companion/bridge/src/cli/pitch.ts",
    "companion:mic-check": "tsx companion/bridge/src/cli/mic-check.ts",
    "companion:clips": "tsx companion/bridge/src/cli/clips.ts",
    "companion:talk-clips": "tsx companion/bridge/src/cli/clips.ts --talk"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.109",
    "@orpc/client": "2.0.0-beta.44",
    "ai": "^7.0.159",
    "esphome-client": "2.0.0",
    "eve": "1.0.0-rc.1",
    "tsx": "^4.23.13",
    "ws": "^8.21.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/ws": "^8.18.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
